<Window x:Class="WebChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WebChat"
        Width="420" Height="640" MinWidth="320" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#181825" Padding="8,0">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="TitleText" Text="WebChat · DeepSeek" Foreground="#CDD6F4"
                   VerticalAlignment="Center" FontSize="12" />
        <Button DockPanel.Dock="Right" x:Name="PinButton" Content="置顶" Click="Pin_Click"
                Background="Transparent" Foreground="#89B4FA" BorderThickness="0"
                Cursor="Hand" FontSize="12" Margin="6,0,0,0" />
        <Button DockPanel.Dock="Right" x:Name="TrayButton" Content="托盘" Click="Tray_Click"
                Background="Transparent" Foreground="#A6ADC8" BorderThickness="0"
                Cursor="Hand" FontSize="12" Margin="6,0,0,0" />
      </DockPanel>
    </Border>

    <wv2:WebView2 Grid.Row="1" x:Name="Web" />
  </Grid>
</Window>
